# All optional. With nothing set the app runs fully local: simulated AI in the sales demo, and the working
# prototype reads known invoice layouts with code (scans go to "needs a person").

# Neon Postgres connection string (production on Vercel). Unset = local PGlite in ./.pglite
DATABASE_URL=

# AI for the working prototype (and the sales demo). Groq is the default when its key is set.
# Create a SEPARATE key for this project at console.groq.com -> API Keys.
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional switch to Claude (bills separately from a Claude Pro plan): LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
